{
  "name": "restodash-pos",
  "productName": "RestoDash POS",
  "version": "1.0.0",
  "description": "",
  "main": "src/main.js",
  "scripts": {
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "start": "npm run rebuild:native && npm run build:renderer && electron .",
    "build:renderer": "vite build",
    "typecheck": "tsc --noEmit",
    "dist": "npm run build:renderer && electron-builder --win",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev:renderer": "vite --host"
  },
  "keywords": [],
  "author": "Theekshana__j",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@tailwindcss/vite": "^4.1.14",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.0.12",
    "tailwindcss": "^4.1.14",
    "typescript": "^5.9.3",
    "vite": "^7.1.9"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "build": {
    "appId": "com.restodash.pos",
    "productName": "RestoDash POS",
    "icon": "build/restodash.png",
    "files": [
      "src/**/*",
      "renderer/dist/**/*",
      "build/**/*",
      "package.json"
    ],
    "win": {
      "target": "nsis",
      "icon": "build/restodash.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  }
}
